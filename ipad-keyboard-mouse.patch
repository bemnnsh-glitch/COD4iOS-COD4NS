+// Hardware keyboard. Mirrors Windows: every key is an SE_KEY down/up, and a printable key also queues
+// an SE_CHAR on key-down (console and text fields consume those). The soft keyboard still goes through
+// insertText:/deleteBackward below. Held keys are tracked so they can be released if the app loses focus.
+- (NSMutableSet<NSNumber *> *)heldKeys
+{
+    static NSMutableSet<NSNumber *> *held = [NSMutableSet new];
+    return held;
+}
+- (void)handlePresses:(NSSet<UIPress *> *)presses down:(BOOL)down
+{
+    NSMutableSet<NSNumber *> *held = [self heldKeys];
+    for (UIPress *press in presses)
+    {
+        UIKey *uiKey = press.key;
+        if (!uiKey) continue;
+        const int key = KISEngineKeyForUsage(uiKey.keyCode);
+        if (!key) continue;
+        NSNumber *tag = @(key);
+        if (down)
+        {
+            [held addObject:tag];
+            KisakApple_KeyEvent(key, 1);
+            const UIKeyModifierFlags command = UIKeyModifierCommand | UIKeyModifierControl;
+            NSString *characters = uiKey.characters;
+            if (!(uiKey.modifierFlags & command) && characters.length == 1)
+                KisakApple_TextInput(characters.UTF8String);   // filters to printable ASCII
+        }
+        else if ([held containsObject:tag])
+        {
+            [held removeObject:tag];
+            KisakApple_KeyEvent(key, 0);
+        }
+    }
+}
+- (void)releaseAllKeys
+{
+    NSMutableSet<NSNumber *> *held = [self heldKeys];
+    for (NSNumber *key in held) KisakApple_KeyEvent(key.intValue, 0);
+    [held removeAllObjects];
+}
+- (void)pressesBegan:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+{
+    NSMutableSet<UIPress *> *unhandled = [NSMutableSet set];
+    for (UIPress *press in presses)
+        if (!press.key || !KISEngineKeyForUsage(press.key.keyCode)) [unhandled addObject:press];
+    [self handlePresses:presses down:YES];
+    if (unhandled.count) [super pressesBegan:unhandled withEvent:event];   // leave Command/Globe shortcuts to iPadOS
+}
+- (void)pressesEnded:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+{
+    [self handlePresses:presses down:NO];
+    [super pressesEnded:presses withEvent:event];
+}
+- (void)pressesCancelled:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+{
+    [self handlePresses:presses down:NO];
+    [super pressesCancelled:presses withEvent:event];
+}
