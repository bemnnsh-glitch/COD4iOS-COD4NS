+// Hardware keyboard and mouse, called from the launcher (UI thread).
+void KisakApple_KeyEvent(int key, int down)
+{
+    if (key > 0 && key < K_LAST_KEY)
+        Sys_QueEvent(0, SE_KEY, key, down ? 1 : 0, 0, nullptr);
+}
+
+void KisakApple_MouseMotion(float dx, float dy, float uiScale)
+{
+    std::lock_guard<std::mutex> guard(g_touchLock);
+    g_mouseEvents.push_back(KisakMouseEvent{0, dx, dy, uiScale, 0, 0});
+}
+
+void KisakApple_MouseButton(int button, int down) // 0 left, 1 right, 2 middle, 3/4 side buttons
+{
+    if (button < 0 || button > 4)
+        return;
+    std::lock_guard<std::mutex> guard(g_touchLock);
+    g_mouseEvents.push_back(KisakMouseEvent{1, 0, 0, 1, K_MOUSE1 + button, down ? 1 : 0});
+}
+
+void KisakApple_MouseScroll(float amount) // positive = wheel up
+{
+    std::lock_guard<std::mutex> guard(g_touchLock);
+    g_mouseEvents.push_back(KisakMouseEvent{2, 0, amount, 1, 0, 0});
+}
+
+bool KisakApple_GetDisplaySize(int *width, int *height);
+
+// Replays queued mouse events on the engine thread. CL_MouseEvent takes both an absolute position (menus,
+// render-target pixels) and a raw delta (gameplay look), so the cursor is clamped to the screen while the
+// delta is passed through untouched - clamping it would stall looking at the screen edge.
+static void KisakApple_ReplayMouse(const std::vector<KisakMouseEvent> &events)
+{
+    int width = 0, height = 0;
+    KisakApple_GetDisplaySize(&width, &height);
+    const int maxX = width > 0 ? width - 1 : 0;
+    const int maxY = height > 0 ? height - 1 : 0;
+    for (const KisakMouseEvent &event : events)
+    {
+        if (!g_haveCursor)
+        {
+            g_cursorX = width / 2;
+            g_cursorY = height / 2;
+            g_haveCursor = true;
+        }
+        if (event.kind == 0)
+        {
+            // Carry the sub-count remainder so slow, precise movement is not rounded away.
+            const float totalX = event.dx + g_mouseRemainderX;
+            const float totalY = event.dy + g_mouseRemainderY;
+            const int ix = static_cast<int>(std::lround(totalX));
+            const int iy = static_cast<int>(std::lround(totalY));
+            g_mouseRemainderX = totalX - ix;
+            g_mouseRemainderY = totalY - iy;
+            g_cursorX = std::clamp(g_cursorX + static_cast<int>(std::lround(event.dx * event.scale)), 0, maxX);
+            g_cursorY = std::clamp(g_cursorY + static_cast<int>(std::lround(event.dy * event.scale)), 0, maxY);
+            if (ix || iy)
+                CL_MouseEvent(g_cursorX, g_cursorY, ix, iy);
+        }
+        else if (event.kind == 1)
+        {
+            // Move first so a click lands where the cursor is, as the touch path does.
+            CL_MouseEvent(g_cursorX, g_cursorY, 0, 0);
+            Sys_QueEvent(0, SE_KEY, event.key, event.down, 0, nullptr);
+        }
+        else if (event.dy != 0.0f)
+        {
+            const int wheel = event.dy > 0.0f ? K_MWHEELUP : K_MWHEELDOWN;
+            Sys_QueEvent(0, SE_KEY, wheel, 1, 0, nullptr);
+            Sys_QueEvent(0, SE_KEY, wheel, 0, 0, nullptr);
+        }
+    }
+}
