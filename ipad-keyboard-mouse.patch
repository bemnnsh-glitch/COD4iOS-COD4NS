+// ---------------------------------------------------------------------------
+// Hardware keyboard and mouse (Magic Keyboard / trackpad / USB or Bluetooth mouse).
+//
+// Keys go to the engine as the same SE_KEY events a Windows keyboard produces, so the game's own PC
+// bindings (default_mp.cfg: WASD, mouse1 = attack, ...) apply unchanged. The mouse arrives as raw
+// GCMouse deltas; the pointer is locked while a mouse is connected, so the system cursor never fights
+// the engine's own menu cursor.
+
+// UIKeyboardHIDUsage (USB HID usage page 7) -> engine key (ui/keycodes.h). 0 = not mapped.
+static int KISEngineKeyForUsage(NSInteger usage)
+{
+    if (usage >= 0x04 && usage <= 0x1D) return 'a' + static_cast<int>(usage - 0x04);   // A-Z
+    if (usage >= 0x1E && usage <= 0x26) return '1' + static_cast<int>(usage - 0x1E);   // 1-9
+    if (usage == 0x27) return '0';
+    if (usage >= 0x3A && usage <= 0x45) return 0xA7 + static_cast<int>(usage - 0x3A);  // K_F1..K_F12
+    if (usage >= 0x68 && usage <= 0x6A) return 0xB3 + static_cast<int>(usage - 0x68);  // K_F13..K_F15
+    switch (usage)
+    {
+    case 0x28: return 0x0D;   // Return        K_ENTER
+    case 0x29: return 0x1B;   // Escape        K_ESCAPE
+    case 0x2A: return 0x7F;   // Backspace     K_BACKSPACE
+    case 0x2B: return 0x09;   // Tab           K_TAB
+    case 0x2C: return 0x20;   // Space         K_SPACE
+    case 0x2D: return '-';   case 0x2E: return '=';
+    case 0x2F: return '[';   case 0x30: return ']';   case 0x31: return '\\';
+    case 0x33: return ';';   case 0x34: return '\'';
+    case 0x35: return '`';                              // console key
+    case 0x36: return ',';   case 0x37: return '.';   case 0x38: return '/';
+    case 0x39: return 0x97;   // Caps Lock     K_CAPSLOCK
+    case 0x48: return 0x99;   // Pause         K_PAUSE
+    case 0x49: return 0xA1;   // Insert        K_INS
+    case 0x4A: return 0xA5;   // Home          K_HOME
+    case 0x4B: return 0xA4;   // Page Up       K_PGUP
+    case 0x4C: return 0xA2;   // Delete        K_DEL
+    case 0x4D: return 0xA6;   // End           K_END
+    case 0x4E: return 0xA3;   // Page Down     K_PGDN
+    case 0x4F: return 0x9D;   // Right         K_RIGHTARROW
+    case 0x50: return 0x9C;   // Left          K_LEFTARROW
+    case 0x51: return 0x9B;   // Down          K_DOWNARROW
+    case 0x52: return 0x9A;   // Up            K_UPARROW
+    case 0x53: return 0xC5;   // Num Lock      K_KP_NUMLOCK
+    case 0x54: return 0xC2;   // Keypad /      K_KP_SLASH
+    case 0x55: return 0xC6;   // Keypad *      K_KP_STAR
+    case 0x56: return 0xC3;   // Keypad -      K_KP_MINUS
+    case 0x57: return 0xC4;   // Keypad +      K_KP_PLUS
+    case 0x58: return 0xBF;   // Keypad Enter  K_KP_ENTER
+    case 0x59: return 0xBC;   // Keypad 1      K_KP_END
+    case 0x5A: return 0xBD;   // Keypad 2      K_KP_DOWNARROW
+    case 0x5B: return 0xBE;   // Keypad 3      K_KP_PGDN
+    case 0x5C: return 0xB9;   // Keypad 4      K_KP_LEFTARROW
+    case 0x5D: return 0xBA;   // Keypad 5      K_KP_5
+    case 0x5E: return 0xBB;   // Keypad 6      K_KP_RIGHTARROW
+    case 0x5F: return 0xB6;   // Keypad 7      K_KP_HOME
+    case 0x60: return 0xB7;   // Keypad 8      K_KP_UPARROW
+    case 0x61: return 0xB8;   // Keypad 9      K_KP_PGUP
+    case 0x62: return 0xC0;   // Keypad 0      K_KP_INS
+    case 0x63: return 0xC1;   // Keypad .      K_KP_DEL
+    case 0x67: return 0xC7;   // Keypad =      K_KP_EQUALS
+    case 0xE0: case 0xE4: return 0x9F;   // Ctrl   K_CTRL
+    case 0xE1: case 0xE5: return 0xA0;   // Shift  K_SHIFT
+    case 0xE2: case 0xE6: return 0x9E;   // Alt    K_ALT
+    default: return 0;        // Command/Globe and anything else stay with iPadOS
+    }
+}
