+@interface KISKeyboardMouseInput : NSObject
+@property(nonatomic,readonly) BOOL mouseConnected;
+@property(nonatomic,weak) UIView *view;               // for the points -> render pixels scale
+@property(nonatomic,copy) void (^changed)(void);      // mouse connected/disconnected
+- (void)start;
+@end
+
+@implementation KISKeyboardMouseInput
+- (void)start
+{
+    NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
+    [center addObserver:self selector:@selector(mouseChanged:) name:GCMouseDidConnectNotification object:nil];
+    [center addObserver:self selector:@selector(mouseChanged:) name:GCMouseDidDisconnectNotification object:nil];
+    [self mouseChanged:nil];
+}
+- (float)uiScale
+{
+    UIView *view = self.view;
+    const CGFloat width = view.bounds.size.width;
+    if (!view || width <= 0) return 1.0f;
+    return static_cast<float>(((CAMetalLayer *)view.layer).drawableSize.width / width);
+}
+- (void)bind:(GCMouse *)mouse
+{
+    GCMouseInput *input = mouse.mouseInput;
+    if (!input) return;
+    __weak KISKeyboardMouseInput *weakSelf = self;
+    input.mouseMovedHandler = ^(GCMouseInput *m, float dx, float dy) {
+        (void)m;
+        // GameController reports +y as up; the engine, like Windows, wants +y as down.
+        KisakApple_MouseMotion(dx, -dy, [weakSelf uiScale]);
+    };
+    GCControllerButtonInput *buttons[] = { input.leftButton, input.rightButton, input.middleButton };
+    for (int i = 0; i < 3; ++i)
+        buttons[i].pressedChangedHandler = ^(GCControllerButtonInput *b, float v, BOOL pressed) {
+            (void)b; (void)v;
+            KisakApple_MouseButton(i, pressed);
+        };
+    NSArray<GCControllerButtonInput *> *aux = input.auxiliaryButtons;
+    for (NSUInteger i = 0; i < aux.count && i < 2; ++i)
+        aux[i].pressedChangedHandler = ^(GCControllerButtonInput *b, float v, BOOL pressed) {
+            (void)b; (void)v;
+            KisakApple_MouseButton(3 + static_cast<int>(i), pressed);
+        };
+    input.scroll.yAxis.valueChangedHandler = ^(GCControllerAxisInput *axis, float value) {
+        (void)axis;
+        KisakApple_MouseScroll(value);
+    };
+}
+- (void)mouseChanged:(NSNotification *)notification
+{
+    (void)notification;
+    for (GCMouse *mouse in GCMouse.mice) [self bind:mouse];
+    const BOOL connected = GCMouse.mice.count > 0;
+    if (connected != _mouseConnected)
+    {
+        _mouseConnected = connected;
+        fprintf(stderr, "Mouse: %s\n", connected ? "connected" : "disconnected");
+        if (self.changed) self.changed();
+    }
+}
+- (void)dealloc { [NSNotificationCenter.defaultCenter removeObserver:self]; }
+@end
 
